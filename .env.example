# Copy to .env and fill in. Setup guide: .claude/rpi-hub-setup.md in the hyperloop-gui repo.

# Which config/profiles/<name>.yaml to use: lab-hub, cellular-hub or dev-sim
HUB_PROFILE=lab-hub

# Hub identity: must match an entry in the cloud's DEVICE_TOKENS (hub-id:token)
HUB_ID=rpi-bridge-01
DEVICE_TOKEN=your-device-token-here
SERVER_ENDPOINT=wss://api.cornellhyperloop.com/hub

# Local debugging API (loopback only unless you change API_HOST)
API_HOST=127.0.0.1
API_PORT=8000

# Serial
DEFAULT_BAUD_RATE=9600
PORT_SCAN_INTERVAL=2
CONNECTION_RETRY_ATTEMPTS=3

# Outbound buffer (telemetry is kept through cloud outages up to this size)
BUFFER_SIZE_MB=10
BUFFER_WARN_THRESHOLD=0.8

# Health reports
HEALTH_REPORT_INTERVAL=30

# Storage Paths
PORT_MAPPING_FILE=/var/lib/rpi-hub/port_mappings.json

# Logging
LOG_LEVEL=INFO
